{
  "functions": {
    "api/submit-application.js": {
      "memory": 128,
      "maxDuration": 30
    },
    "api/submit-contact.js": {
      "memory": 128,
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync-crew-calendar",
      "schedule": "*/15 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
