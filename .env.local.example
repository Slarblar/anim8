# Copy this file to .env.local and fill in real values for local dev.
# In production (Vercel), set these under Project Settings -> Environment Variables.

# --- Asana (client portal + intake automation) ---
ASANA_ACCESS_TOKEN=
ASANA_WORKSPACE_GID=1210991035370090
# Legacy scripts (api/submit-application.js, api/submit-contact.js) read ASANA_PAT.
ASANA_PAT=

# --- Vercel KV (client links, crew directory, PTO requests, crew status cache) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Client portal notification emails (optional — skipped if unset) ---
RESEND_API_KEY=
CLIENT_PORTAL_TEAM_EMAIL=hello@anim-8.xyz
CLIENT_PORTAL_FROM_EMAIL="Anim-8 Client Portal <onboarding@resend.dev>"

# --- Admin + Crew portal auth (Sign in with Google via NextAuth) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth Client ID (Web application).
# Authorized redirect URIs must include ALL of:
#   https://www.anim-8.xyz/api/auth/callback/google
#   https://www.anim-8studios.com/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google  (dev)
#
# IMPORTANT: the OAuth consent screen (Google Auth Platform -> Audience tab)
# must be set to "External" and Published, NOT "Internal". We have two
# separate Workspace orgs (anim-8.xyz leadership, anim-8studios.com crew) —
# "Internal" only allows the one org that owns the GCP project and blocks
# the other domain with an "Error 403: org_internal" screen. Publishing as
# External (safe here since we only request non-sensitive openid/email/
# profile scopes, so no Google verification review is needed) lets both
# domains sign in; ADMIN_EMAILS + the crew directory below are what
# actually gate access, not Google's org restriction.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random 32+ char string — `openssl rand -base64 32`. Required for JWT session signing.
NEXTAUTH_SECRET=
# Local dev only — DO NOT set this in Vercel Production. This one deployment
# serves both anim-8.xyz and anim-8studios.com as first-class login domains;
# a hardcoded NEXTAUTH_URL forces every OAuth callback onto a single domain
# and breaks sign-in on the other one. lib/auth.ts sets `trustHost: true` so
# Production infers the right URL per-request from the Host header instead.
NEXTAUTH_URL=http://localhost:3000
# Comma-separated list of admin emails, e.g. "jordan@anim-8.xyz,chris@anim-8.xyz".
ADMIN_EMAILS=

# --- Google Calendar sync for PTO/WFH (Phase 3/4) ---
# Google Cloud Console -> IAM & Admin -> Service Accounts -> create one, generate a JSON key.
# Then share your team calendar with the service account email ("Make changes to events").
GOOGLE_CALENDAR_SA_EMAIL=
GOOGLE_CALENDAR_SA_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# Secret Vercel Cron sends as "Authorization: Bearer <value>" to the /api/cron/* routes
# (calendar sync every 15 min, monthly PTO accrual on the 1st, weekly digest Mondays).
# Vercel sets this automatically when you add the var — see vercel.json for the schedules.
CRON_SECRET=

# Weekly digest email (Monday 8am VN / Sunday evening US) reuses RESEND_API_KEY above
# and sends to everyone in ADMIN_EMAILS — no separate var needed.
